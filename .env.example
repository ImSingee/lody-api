# Required ------------------------------------------------------------------

# Bearer keys accepted by this API, comma-separated (two keys allow rotation).
# Each at least 16 characters, e.g. `openssl rand -hex 32`.
API_KEYS=

# Lody CLI API key (not a one-time lody_pair_ token).
LODY_CLI_API_KEY=

# Optional ------------------------------------------------------------------

# Default workspace (id, slug or name). Required when the account has several.
LODY_WORKSPACE=

# Image tag: main (latest main build), a short commit sha, or a version like 1.2.3.
LODY_API_TAG=main

# Host interface and port to publish on. Keep 127.0.0.1 behind a reverse proxy.
LODY_API_BIND=127.0.0.1
LODY_API_PORT=8080

LODY_MACHINE_NAME=lody-api
LOG_LEVEL=info

# Tuning (empty = built-in default; see README for the full list).
LODY_CLI_CONCURRENCY=
SESSION_LIST_CACHE_TTL_MS=
SYNC_WAIT_MAX_SECONDS=
