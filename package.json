{
  "name": "lody-api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API over the Lody CLI for listing sessions and sending messages",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "lody": "0.108.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.4.1"
}
